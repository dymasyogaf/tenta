---
import BaseLayout from '@layouts/BaseLayout.astro';
import ArrowRight from '@components/icons/ArrowRight.astro';
import { PARTNER_ITEMS } from '@data/partners';
import { breadcrumbJsonLd, itemListJsonLd } from '@lib/seo';
import { site } from '@data/site';
import { getLang, useT } from '@i18n/utils';

const lang = getLang(Astro.currentLocale);
const tr = useT(lang);
const L = (p: string) => (lang === 'en' ? '/en' + (p === '/' ? '' : p) : p) || '/';

const categories = ['Semua', 'Hosting', 'Plugin', 'Payment Gateway'];

const url = `${site.url}/partner`;
const jsonLd = [
  breadcrumbJsonLd([
    { name: tr('crumb.beranda'), url: site.url },
    { name: tr('nav.partner'), url },
  ]),
  itemListJsonLd(
    PARTNER_ITEMS.map(p => ({
      name: p.title,
      url: p.url,
      description: `${p.category} — ${p.title}`,
    })),
    'Partner Tentaklik',
  ),
];

const seoTitle = 'Partner & Rekomendasi Tools — Tentaklik';
const seoDesc = 'Rekomendasi hosting terbaik, plugin website, dan payment gateway resmi pilihan partner Tentaklik untuk akselerasi bisnis online Anda.';
---
<BaseLayout
  title={seoTitle}
  description={seoDesc}
  active="case"
  jsonLd={jsonLd}
  keywords={['partner tentaklik', 'rekomendasi hosting', 'hosting murah', 'plugin donasi', 'tripay payment gateway']}
>
  <section class="partner-hero">
    <div class="container partner-hero-container">
      <span class="eyebrow">{tr('partner.eyebrow')}</span>
      <h1 class="partner-hero-title">
        {tr('partner.title1')} <span style="color:var(--orange-500);">{tr('partner.titleAccent')}</span>
      </h1>
      <p class="partner-hero-desc">
        {tr('partner.lede')}
      </p>
    </div>
  </section>

  <section style="padding-top:20px;padding-bottom:60px;">
    <div class="container">
      <!-- Filter Tabs -->
      <div class="filter-wrap">
        {categories.map((cat, i) => (
          <button class={`filter-btn${i === 0 ? ' active' : ''}`} data-filter={cat}>{cat}</button>
        ))}
      </div>

      <!-- Partner Cards Grid -->
      <div id="partner-grid" class="partner-grid">
        {PARTNER_ITEMS.map(item => (
          <div class="card reveal partner-card" data-category={item.category}>
            <div class="partner-cover">
              <img
                src={item.image}
                alt={item.title}
                loading="lazy"
                decoding="async"
                width="640"
                height="360"
              />
            </div>
            <div class="partner-body">
              <span class="partner-cat">{item.category}</span>
              <h3 class="partner-item-title">{item.title}</h3>
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-partner"
              >
                {item.btnText}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section style="padding-bottom:48px;">
    <div class="container">
      <div class="cta-banner reveal">
        <div style="flex:1;">
          <h3>{tr('partner.cta.title')}</h3>
          <p style="margin-top:8px;opacity:0.95;font-size:15px;">{tr('partner.cta.desc')}</p>
        </div>
        <a href={L('/kontak')} class="btn btn-ghost">{tr('partner.cta.btn')} <ArrowRight size={14} /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .partner-hero {
    padding-top: 56px;
    padding-bottom: 32px;
    background: var(--bg-warm);
  }
  .partner-hero-container {
    text-align: center;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .partner-hero-title {
    font-size: clamp(32px, 5vw, 48px);
    margin-top: 18px;
    margin-bottom: 14px;
    line-height: 1.2;
  }
  .partner-hero-desc {
    font-size: 16px;
    color: var(--ink-500);
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.65;
    white-space: pre-line;
  }
  .filter-wrap {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }
  .filter-btn {
    padding: 8px 20px;
    border-radius: 10px;
    border: 1.5px solid var(--ink-100);
    background: white;
    color: var(--ink-700);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: inherit;
  }
  .filter-btn:hover {
    border-color: var(--orange-300);
    color: var(--orange-600);
  }
  .filter-btn.active {
    border-color: var(--orange-500);
    background: var(--orange-500);
    color: white;
  }

  .partner-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .partner-card {
    padding: 16px;
    border-radius: 16px;
    border: 1.5px solid var(--ink-100);
    background: white;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .partner-card:hover {
    transform: translateY(-4px);
    border-color: var(--orange-300);
    box-shadow: 0 12px 30px rgba(0,0,0,0.08);
  }
  .partner-card[hidden] {
    display: none !important;
  }

  .partner-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 12px;
    background: var(--orange-50);
  }
  .partner-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .partner-card:hover .partner-cover img {
    transform: scale(1.03);
  }

  .partner-body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .partner-cat {
    font-size: 12px;
    font-weight: 700;
    color: #0284c7;
    letter-spacing: 0.04em;
    margin-bottom: 6px;
  }
  .partner-item-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--ink-900);
    line-height: 1.35;
    margin: 0 0 18px 0;
    flex: 1;
  }
  .btn-partner {
    width: 100%;
    background: #3bad25;
    color: white;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 700;
    padding: 12px 20px;
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    box-shadow: 0 4px 14px rgba(59, 173, 37, 0.28);
  }
  .btn-partner:hover {
    background: #32961f;
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgba(59, 173, 37, 0.36);
  }

  @media (max-width: 960px) {
    .partner-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 768px) {
    .partner-hero {
      padding-top: 40px;
      padding-bottom: 24px;
    }
    .partner-hero-container {
      align-items: flex-start;
      text-align: left;
    }
    .partner-hero-container .eyebrow {
      align-self: center;
      margin-inline: auto;
    }
    .partner-hero-title {
      font-size: clamp(26px, 6.5vw, 34px);
      text-align: left;
      width: 100%;
    }
    .partner-hero-desc {
      text-align: left;
      max-width: 100%;
      margin-left: 0;
      margin-right: 0;
      font-size: 15px;
    }
    .filter-wrap {
      justify-content: flex-start;
      gap: 8px;
      margin-bottom: 24px;
    }
  }

  @media (max-width: 600px) {
    .partner-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .partner-item-title {
      font-size: 16px;
    }
  }
</style>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.partner-card');

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'Semua';
      btns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      cards.forEach(card => {
        const cat = card.dataset.category ?? '';
        const visible = filter === 'Semua' || cat.toUpperCase() === filter.toUpperCase();
        if (visible) card.removeAttribute('hidden');
        else card.setAttribute('hidden', '');
      });
    });
  });
</script>
