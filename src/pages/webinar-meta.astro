    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .wm-modal-close:hover {
    background: rgba(255, 255, 255, 0.2);
    color: white;
  }
  .wm-modal-body {
    padding: 12px;
    background: #020617;
    display: flex;
    align-items: center;
    justify-content: center;
    max-height: 80vh;
    overflow: auto;
  }
  .wm-modal-image {
    width: 100%;
    height: auto;
    max-height: 75vh;
    object-fit: contain;
    border-radius: 8px;
  }
  .wm-modal-footer {
    padding: 10px 20px;
    text-align: center;
    font-size: 12px;
    color: #94A3B8;
    background: rgba(15, 23, 42, 0.95);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .wm-modal-footer kbd {
    background: rgba(255, 255, 255, 0.12);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    color: #F8FAFC;
  }

  /* 3. Curriculum Grid */
  .wm-curriculum-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  .wm-curriculum-card {
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .wm-curriculum-card:nth-child(5) {
    grid-column: 1 / -1;
    width: 100%;
    max-width: calc(50% - 12px);
    margin-inline: auto;
  }
  .wm-curr-title {
    font-size: 16.5px;
    font-weight: 700;
    color: var(--ink-900);
    line-height: 1.35;
    margin: 0 0 12px 0;
  }
  .wm-curr-lead {
    font-size: 14.5px;
    font-weight: 400;
    color: var(--ink-700);
    line-height: 1.5;
    margin-bottom: 8px;
  }
  .wm-curr-desc {
    font-size: 14px;
    font-weight: 400;
    color: var(--ink-500);
    line-height: 1.6;
    margin: 0;
  }
  .wm-curr-bullets, .wm-curr-questions {
    list-style: none;
    padding: 0;
    margin: 12px 0 14px 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .wm-curr-bullets li, .wm-curr-questions li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 400;
    color: var(--ink-800);
  }
  .wm-bullet-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--orange-500);
    display: inline-block;
  }
  .wm-q-arrow {
    color: var(--orange-500);
    font-weight: 600;
  }
  .wm-curr-sublead {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-700);
    margin: 14px 0 6px 0;
  }

  .wm-framework-wrap {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--ink-100);
  }
  .wm-framework-cell {
    border-radius: 12px;
    padding: 12px;
    border: 1px solid var(--ink-100);
  }
  .wm-framework-cell.f-stop {
    background: #FEF2F2;
    border-color: #FECACA;
  }
  .wm-framework-cell.f-stop .wm-framework-label { color: #DC2626; }
  .wm-framework-cell.f-wait {
    background: #FFFBEB;
    border-color: #FDE68A;
  }
  .wm-framework-cell.f-wait .wm-framework-label { color: #D97706; }
  .wm-framework-cell.f-scale {
    background: #ECFDF5;
    border-color: #A7F3D0;
  }
  .wm-framework-cell.f-scale .wm-framework-label { color: #059669; }
  .wm-framework-label {
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 4px;
  }
  .wm-framework-desc {
    font-size: 11.5px;
    font-weight: 400;
    color: var(--ink-700);
    line-height: 1.45;
  }

  /* 4. Audience Grid */
  .wm-audience-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 18px;
  }
  .wm-aud-card {
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }
  .wm-aud-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .wm-aud-num {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--orange-50);
    color: var(--orange-700);
    font-size: 13px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .wm-aud-check {
    color: #059669;
  }
  .wm-aud-role {
    font-size: 14.5px;
    font-weight: 700;
    color: var(--ink-900);
    margin: 0 0 8px 0;
    letter-spacing: -0.01em;
  }
  .wm-aud-desc {
    font-size: 13px;
    font-weight: 400;
    color: var(--ink-500);
    line-height: 1.55;
    margin: 0;
  }

  /* 5 & 6. Speaker & Agenda — side by side */
  .wm-sa-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 0;
    align-items: stretch;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(31,26,23,0.05);
  }

  /* LEFT: Speaker panel */
  .wm-sa-speaker {
    background: var(--bg-warm, #FFF8F3);
    padding: 44px 36px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .wm-sa-eyebrow {
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--orange-600);
    border-left: 3px solid var(--orange-500);
    padding-left: 10px;
    margin-bottom: 28px;
  }
  .wm-sa-avatar {
    width: 250px;
    height: 250px;
    border-radius: 50%;
    object-fit: cover;
    border: 6px solid var(--orange-100);
    box-shadow: 0 12px 36px rgba(31,26,23,0.14);
    margin-bottom: 24px;
  }
  .wm-sa-name {
    font-size: 21px;
    font-weight: 800;
    color: var(--ink-900);
    margin: 0 0 6px 0;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .wm-sa-role {
    font-size: 14px;
    font-weight: 600;
    color: var(--orange-600);
    line-height: 1.5;
    margin: 0 0 20px 0;
  }
  .wm-sa-bio {
    font-size: 13.5px;
    font-weight: 400;
    color: var(--ink-500);
    line-height: 1.7;
    margin: 0;
  }

  /* RIGHT: Agenda panel */
  .wm-sa-agenda {
    background: #FFFFFF;
    padding: 44px 40px;
    display: flex;
    flex-direction: column;
  }
  .wm-sa-heading {
    font-size: 26px;
    font-weight: 800;
    color: var(--ink-900);
    margin: 0 0 32px 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .wm-sa-items {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .wm-sa-item {
    display: flex;
    align-items: flex-start;
    gap: 18px;
  }
  .wm-sa-num {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--ink-900);
    color: white;
    font-size: 14px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .wm-sa-item-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding-top: 2px;
  }
  .wm-sa-item-title {
    font-size: 15.5px;
    font-weight: 700;
    color: var(--ink-900);
    line-height: 1.35;
  }
  .wm-sa-item-desc {
    font-size: 14px;
    font-weight: 400;
    color: var(--ink-500);
    line-height: 1.5;
  }

  /* 7. Value Prop — Minimalist Card */
  .wm-vp-card {
    background: white;
    border: 1px solid var(--ink-100);
    border-radius: 24px;
    padding: 48px;
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
    box-shadow: 0 4px 20px rgba(31,26,23,0.04);
  }
  .wm-vp-card .wm-sa-eyebrow {
    border-left: none;
    padding-left: 0;
    display: inline-block;
    margin-bottom: 16px;
    text-align: center;
  }
  .wm-vp-heading {
    font-size: 24px;
    font-weight: 800;
    color: var(--ink-900);
    margin: 0 0 8px 0;
    line-height: 1.25;
    letter-spacing: -0.02em;
    text-align: center;
  }
  .wm-vp-sub {
    font-size: 15px;
    font-weight: 400;
    color: var(--ink-500);
    margin: 0 0 16px 0;
    text-align: center;
  }
  .wm-vp-schedule-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FFF7ED;
    border: 1px solid var(--orange-200);
    color: var(--orange-700, #C2410C);
    font-size: 13.5px;
    font-weight: 600;
    padding: 6px 16px;
    border-radius: 999px;
    margin-bottom: 28px;
    box-shadow: 0 2px 6px rgba(255,122,26,0.05);
  }
  .wm-vp-perks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px 28px;
    margin-bottom: 36px;
  }
  .wm-vp-perk {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-700);
  }
  .wm-vp-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .wm-vp-note {
    font-size: 13px;
    font-weight: 400;
    color: var(--ink-400);
    margin: 0;
    text-align: center;
  }

  /* 8. Closing Hook — Minimalist Card */
  .wm-ch-card {
    background: white;
    border: 1px solid var(--ink-100);
    border-radius: 24px;
    padding: 44px 36px;
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
    box-shadow: 0 4px 20px rgba(31,26,23,0.04);
  }
  .wm-ch-heading {
    font-size: 24px;
    font-weight: 800;
    color: var(--ink-900);
    margin: 0 0 14px 0;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .wm-ch-lead {
    font-size: 15px;
    font-weight: 400;
    color: var(--ink-600);
    margin: 0 0 6px 0;
    line-height: 1.6;
  }
  .wm-ch-prompt {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink-800);
    margin: 0 0 20px 0;
  }
  .wm-ch-bullets {
    list-style: none;
    padding: 0;
    margin: 0 auto 24px auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    max-width: 520px;
    text-align: left;
  }
  .wm-ch-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--ink-800);
    line-height: 1.5;
    background: #FFFDF9;
    border: 1px solid var(--orange-100);
    border-radius: 12px;
    padding: 12px 16px;
    box-shadow: 0 2px 6px rgba(255,122,26,0.03);
  }
  .wm-ch-bullets li svg {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 2px;
  }
  .wm-ch-warning {
    max-width: 520px;
    margin: 0 auto;
    background: #FFF8F3;
    border: 1px dashed var(--orange-300);
    border-radius: 14px;
    padding: 14px 18px;
    font-size: 13.5px;
    font-weight: 400;
    color: var(--ink-700);
    line-height: 1.55;
    text-align: center;
  }
  .wm-ch-warning p {
    margin: 0;
  }
  .wm-ch-warning p + p {
    margin-top: 4px;
  }
  .wm-ch-highlight {
    color: var(--orange-600);
    font-weight: 700;
    font-style: normal;
  }
  .wm-ch-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  /* 9. Community Box */
  .wm-community-box {
    max-width: 780px;
    margin: 0 auto;
    background: white;
    border: 2px solid var(--orange-200);
    border-radius: 28px;
    padding: 52px 44px;
    text-align: center;
    box-shadow: 0 16px 44px rgba(255,107,26,0.08);
  }
  .wm-comm-title {
    font-size: 24px;
    font-weight: 700;
    color: var(--ink-900);
    margin: 14px 0 12px 0;
  }
  .wm-comm-desc {
    font-size: 15px;
    font-weight: 400;
    color: var(--ink-500);
    line-height: 1.6;
    max-width: 580px;
    margin: 0 auto 32px auto;
  }
  .wm-comm-perks-box {
    background: var(--orange-50);
    border: 1px solid var(--orange-100);
    border-radius: 20px;
    padding: 24px 28px;
    text-align: left;
    margin-bottom: 36px;
  }
  .wm-comm-perks-heading {
    font-size: 12px;
    font-weight: 700;
    color: var(--orange-700);
    margin-bottom: 18px;
  }
  .wm-comm-perks-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .wm-comm-perk-cell {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  .wm-comm-check-icon {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--orange-500);
    color: white;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .wm-comm-perk-title {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink-900);
    margin: 0 0 2px 0;
  }
  .wm-comm-perk-sub {
    font-size: 13px;
    font-weight: 400;
    color: var(--ink-600);
    margin: 0;
    line-height: 1.45;
  }
  .wm-comm-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    width: 100%;
  }
  .wm-comm-btn {
    background: #229ED9 !important;
    color: white !important;
    border-radius: 10px !important;
    padding: 16px 40px !important;
    font-size: 17px !important;
    font-weight: 800 !important;
    box-shadow: 0 8px 24px rgba(34,158,217,0.35) !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 12px !important;
    letter-spacing: 0.02em;
  }
  .wm-comm-btn:hover {
    background: #1e8dc2 !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 12px 30px rgba(34,158,217,0.45) !important;
  }
  .wm-comm-footnote {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink-500);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
  }
  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #059669;
    display: inline-block;
    box-shadow: 0 0 0 3px rgba(5,150,105,0.2);
  }

  /* Mobile Sticky CTA */
  .wm-mobile-sticky {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 12px 16px;
    background: rgba(255,255,255,0.96);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--ink-100);
    z-index: 999;
    display: none;
  }
  .wm-mobile-sticky-btn {
    width: 100% !important;
    background: var(--orange-500) !important;
    color: white !important;
    border-radius: 10px !important;
    padding: 14px !important;
    font-size: 14.5px !important;
    font-weight: 800 !important;
    display: flex !important;
    justify-content: center !important;
    box-shadow: 0 4px 16px rgba(255,122,26,0.25) !important;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1024px) {
    .wm-hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .wm-hero-title {
      font-size: clamp(20px, 3.2vw, 30px);
    }
    .wm-problems-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .wm-curriculum-grid {
      grid-template-columns: 1fr;
    }
    .wm-curriculum-card:nth-child(5) {
      grid-column: auto;
      max-width: 100%;
      margin-inline: 0;
    }
    .wm-audience-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .wm-sa-grid {
      grid-template-columns: 1fr;
    }
    .wm-sa-heading {
      font-size: 23px;
    }
    .wm-vp-card {
      padding: 36px 28px;
    }
    .wm-vp-heading {
      font-size: 22px;
    }
  }

  @media (max-width: 768px) {
    .wm-hero-section {
      padding-top: 32px;
      padding-bottom: 40px;
    }
    .hero-content {
      text-align: left;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    .hero-badge-wrap {
      justify-content: flex-start;
    }
    .wm-hero-title {
      font-size: clamp(20px, 5.4vw, 26px);
      text-align: left;
      line-height: 1.28;
      margin-top: 14px;
      margin-bottom: 12px;
    }
    .wm-hero-title-line {
      display: block;
    }
    .wm-hero-title-line + .wm-hero-title-line {
      margin-top: 4px;
    }
    .wm-hero-subtitle {
      font-size: 15px;
      text-align: left;
      line-height: 1.5;
      margin-bottom: 18px;
    }
    .wm-hero-event-bar {
      width: 100%;
      margin-bottom: 24px;
    }
    .wm-hevent-card {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding: 14px 16px;
      border-radius: 16px;
      text-align: left;
    }
    .wm-hevent-row {
      width: 100%;
      gap: 12px;
      text-align: left;
      justify-content: flex-start;
    }
    .wm-hevent-divider {
      width: 100%;
      height: 1px;
    }
    .wm-hevent-text {
      font-size: 13px;
    }
    .wm-story-frame {
      padding: 20px 16px;
      border-radius: 16px;
    }
    .wm-story-frame-content {
      font-size: 14px;
      gap: 6px;
    }
    .wm-cta-group {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      gap: 12px;
    }
    .wm-main-btn {
      width: 100%;
      justify-content: center;
    }
    .wm-proof-badge {
      justify-content: flex-start;
    }
    .wm-problems-grid {
      grid-template-columns: 1fr;
    }
    .wm-closer-callout {
      border-radius: 14px;
      padding: 12px 16px;
      justify-content: flex-start;
      text-align: left;
      width: 100%;
    }
    .wm-audience-grid {
      grid-template-columns: 1fr 1fr;
    }
    .wm-framework-wrap {
      grid-template-columns: 1fr;
    }
    .wm-sa-grid {
      border-radius: 20px;
    }
    .wm-sa-speaker {
      padding: 32px 24px;
    }
    .wm-sa-agenda {
      padding: 32px 24px;
    }
    .wm-sa-avatar {
      width: 180px;
      height: 180px;
    }
    .wm-section-title {
      font-size: 22px;
    }
    .wm-sa-heading {
      font-size: 20px;
      margin-bottom: 24px;
    }
    .wm-sa-num {
      width: 36px;
      height: 36px;
    }
    .wm-vp-card {
      padding: 32px 20px;
      text-align: left;
    }
    .wm-vp-card .wm-sa-eyebrow {
      text-align: left;
    }
    .wm-vp-heading {
      font-size: 20px;
      text-align: left;
    }
    .wm-vp-sub {
      text-align: left;
    }
    .wm-vp-perks {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      margin-bottom: 32px;
      text-align: left;
    }
    .wm-vp-perk {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 14.5px;
      text-align: left;
    }
    .wm-vp-footer {
      align-items: stretch;
    }
    .wm-vp-note {
      text-align: center;
    }
    .wm-ch-card {
      padding: 30px 18px;
      border-radius: 20px;
    }
    .wm-ch-heading {
      font-size: 20px;
      margin-bottom: 10px;
    }
    .wm-ch-lead {
      font-size: 14px;
      line-height: 1.5;
    }
    .wm-ch-prompt {
      font-size: 14px;
      margin-bottom: 16px;
    }
    .wm-ch-bullets {
      gap: 10px;
      margin-bottom: 18px;
    }
    .wm-ch-bullets li {
      padding: 10px 14px;
      font-size: 13.5px;
      border-radius: 10px;
      gap: 10px;
    }
    .wm-ch-warning {
      padding: 12px 14px;
      font-size: 13px;
      border-radius: 12px;
    }
    .wm-community-box {
      padding: 36px 20px;
    }
    .wm-comm-title {
      font-size: 21px;
    }
    .wm-comm-btn {
      width: 100% !important;
      justify-content: center !important;
    }
    .wm-mobile-sticky {
      display: block;
