---
import BaseLayout from "@layouts/BaseLayout.astro";
import ArrowRight from "@components/icons/ArrowRight.astro";
import Telegram from "@components/icons/Telegram.astro";
import { WEBINAR_META as W } from "@data/webinar-meta";

const { seo, hero, problems, curriculum, audience, speaker, agenda, valueProp, closingHook, community } = W;
const telegramUrl = W.telegramUrl || 'https://t.me/komunitastentaklik';
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  bareHeader={true}
  bareLayout={true}
  noindex={false}
  gtmId="GTM-T2FDL7NM"
>
  <Fragment slot="head">
    <!-- Meta Pixel Code -->
    <script is:inline>
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod
            ? n.callMethod.apply(n, arguments)
            : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = "2.0";
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(
        window,
        document,
        "script",
        "https://connect.facebook.net/en_US/fbevents.js",
      );
      fbq("init", "1341980327384883");
      fbq("track", "PageView");
    </script>
    <noscript
      ><img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=1341980327384883&ev=PageView&noscript=1"
      /></noscript
    >

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Event",
      "name": "Webinar Meta Ads Tentaklik — Bedah Kesalahan Scaling",
      "startDate": "2026-08-28T19:00:00+07:00",
      "eventAttendanceMode": "https://schema.org/OnlineEventAttendanceMode",
      "eventStatus": "https://schema.org/EventScheduled",
      "location": { "@type": "VirtualLocation", "name": "Zoom" },
      "performer": { "@type": "Person", "name": speaker.name },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "IDR",
        "availability": "https://schema.org/InStock"
      }
    })} />

    <style is:global>
      html {
        scroll-behavior: smooth;
      }
      .footer {
        margin-top: 0 !important;
      }
    </style>
  </Fragment>

  <div class="wm-page">
    <!-- ============ 1. HERO ============ -->
    <section class="hero-wrap wm-hero-section">
      <!-- Ambient Glows -->
      <div aria-hidden="true" class="ambient-glows">
        <div class="glow-top-right"></div>
        <div class="glow-bottom-left"></div>
      </div>

      <div class="container hero-grid wm-hero-grid">
        <!-- Text Column -->
        <div class="hero-content">
          <!-- LIVE SESSION 100% FREE VIA ZOOM -->
          <div class="hero-badge-wrap">
            <div class="hero-badge">
              <span class="hero-badge-icon">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2L4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6l-8-4z" fill="white"/><path d="M9 12l2 2 4-4" stroke="var(--orange-500)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span>{hero.badge}</span>
            </div>
          </div>

          <!-- Punya iklan yang tadinya untung? Pas di-scale kok malah buntung? -->
          <h1 class="hero-title wm-hero-title">
            <span class="wm-hero-title-line">Punya iklan yang <span style="color:var(--orange-500);">tadinya untung?</span></span>
            <span class="wm-hero-title-line">Pas di-scale kok <span style="color:var(--orange-500);">malah buntung?</span></span>
          </h1>

          <!-- Bedah Kesalahan Scaling yang Bikin Campaign Profitable Kehilangan Performanya -->
          <p class="wm-hero-subtitle">
            {hero.subtitle}
          </p>

          <!-- Paragraph -->
          <p class="hero-desc wm-hero-desc">
            {hero.desc}
          </p>

          <!-- [ GABUNG WEBINAR GRATIS ] / 100% Gratis · Live via Zoom -->
          <div class="hero-cta-group wm-cta-group">
            <div class="hero-buttons-wrap">
              <a href="#komunitas" class="btn btn-primary wm-main-btn">
                <span>{hero.ctaText}</span>
                <ArrowRight size={15} />
              </a>
            </div>
            <div class="wm-proof-badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>{hero.ctaSub}</span>
            </div>
          </div>
        </div>

        <!-- Mascot / Hero Visual Column -->
        <div class="hero-mascot-wrap">
          <div class="kraken-float wm-mascot-box">
            <img
              src={hero.mockupSrc}
              alt="Tentaklik Meta Ads Hero"
              width="560"
              height="540"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="wm-mascot-img"
            />
          </div>
        </div>
      </div>

      <!-- Framed Story Card Below Hero Grid -->
      <div class="container wm-story-framed-container">
        <div class="wm-story-frame reveal">
          <div class="wm-story-frame-content">
            {hero.story.map((line, idx) => (
              <p class={idx === 3 ? "wm-story-danger" : idx === 4 ? "wm-story-punch" : "wm-story-line"}>
                {line}
              </p>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 2. KENDALA UTAMA (PERNAH MENGALAMI INI?) ============ -->
    <section class="wm-section bg-warm">
      <div class="container">
        <div class="section-header-wrap">
          <div class="hero-badge wm-section-badge">
            <span>{problems.eyebrow}</span>
          </div>
          <h2 class="section-title wm-section-title">
            {problems.heading}
          </h2>
        </div>

        <div class="wm-problems-grid">
          {problems.items.map((item) => (
            <div class="wm-card wm-problem-card reveal">
              <div class="wm-prob-icon-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
              </div>
              <p class="wm-prob-text">{item}</p>
            </div>
          ))}
        </div>

        <!-- Kalau pernah mengalami ini, webinar ini untuk kamu. -->
        <div class="wm-closer-callout reveal">
          <div class="wm-closer-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <span class="wm-closer-text">{problems.closer}</span>
        </div>
      </div>
    </section>

    <!-- ============ 3. MATERI SESI (YANG AKAN KAMU PELAJARI) ============ -->
    <section id="materi" class="wm-section">
      <div class="container">
        <div class="section-header-wrap">
          <div class="hero-badge wm-section-badge">
            <span>{curriculum.eyebrow}</span>
          </div>
          <h2 class="section-title wm-section-title">
            {curriculum.heading}
          </h2>
        </div>

        <div class="wm-curriculum-grid">
          {curriculum.items.map((item) => (
            <div class="wm-card wm-curriculum-card reveal">
              <div>
                <h3 class="wm-curr-title">{item.title}</h3>
                {item.lead && <p class="wm-curr-lead">{item.lead}</p>}
                {item.desc && <p class="wm-curr-desc">{item.desc}</p>}
                
                {/* 04 Bullets */}
                {item.bullets && (
                  <ul class="wm-curr-bullets">
                    {item.bullets.map((b) => (
                      <li>
                        <span class="wm-bullet-dot"></span>
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {/* 05 Questions */}
                {item.sublead && <p class="wm-curr-sublead">{item.sublead}</p>}
                {item.questions && (
                  <ul class="wm-curr-questions">
                    {item.questions.map((q) => (
                      <li>
                        <span class="wm-q-arrow">→</span>
                        <span>{q}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              {/* 03 Framework STOP - WAIT - SCALE */}
              {item.framework && (
                <div class="wm-framework-wrap">
                  {item.framework.map((f) => (
                    <div class={`wm-framework-cell f-${f.label.toLowerCase()}`}>
                      <div class="wm-framework-label">{f.label}</div>
                      <div class="wm-framework-desc">{f.desc}</div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 4. TARGET PESERTA (SIAPA YANG WAJIB HADIR?) ============ -->
    <section class="wm-section bg-warm">
      <div class="container">
        <div class="section-header-wrap">
          <div class="hero-badge wm-section-badge">
            <span>{audience.eyebrow}</span>
          </div>
          <h2 class="section-title wm-section-title">
            {audience.heading}
          </h2>
          <p class="wm-section-sub">
            {audience.sub}
          </p>
        </div>

        <div class="wm-audience-grid">
          {audience.items.map((item, idx) => (
            <div class="wm-card wm-aud-card reveal">
              <div class="wm-aud-top">
                <span class="wm-aud-num">0{idx + 1}</span>
                <span class="wm-aud-check">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
              </div>
              <h3 class="wm-aud-role">{item.role}</h3>
              <p class="wm-aud-desc">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 5 & 6. PEMBICARA & AGENDA ============ -->
    <section id="pembicara" class="wm-section">
      <div class="container">
        <div class="wm-sa-grid">
          <!-- KIRI: PEMBICARA -->
          <div class="wm-sa-speaker reveal">
            <div class="wm-sa-eyebrow">{speaker.eyebrow}</div>

            <img
              src={speaker.photoSrc}
              alt={speaker.name}
              width="160"
              height="160"
              loading="lazy"
              decoding="async"
              class="wm-sa-avatar"
            />

            <h3 class="wm-sa-name">{speaker.name}</h3>
            <p class="wm-sa-role">
              {speaker.titleLine1}<br/>
              {speaker.titleLine2}
            </p>

            <p class="wm-sa-bio">{speaker.bio}</p>
          </div>

          <!-- KANAN: AGENDA -->
          <div class="wm-sa-agenda reveal">
            <div class="wm-sa-eyebrow">{agenda.eyebrow}</div>
            <h2 class="wm-sa-heading">{agenda.heading}</h2>

            <div class="wm-sa-items">
              {agenda.items.map((item) => (
                <div class="wm-sa-item">
                  <span class="wm-sa-num">{item.num}</span>
                  <div class="wm-sa-item-text">
                    <span class="wm-sa-item-title">{item.title}</span>
                    <span class="wm-sa-item-desc">{item.desc}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 7. LIVE SESSION · 100% GRATIS ============ -->
    <section class="wm-section bg-warm">
      <div class="container">
        <div class="wm-vp-card reveal">
          <div class="wm-vp-top">
            <div class="wm-sa-eyebrow">{valueProp.badge}</div>
            <h2 class="wm-vp-heading">{valueProp.heading}</h2>
            <p class="wm-vp-sub">{valueProp.subheading}</p>
          </div>

          <div class="wm-vp-perks">
            {valueProp.perks.map((perk) => (
              <div class="wm-vp-perk">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" fill="var(--orange-500)" opacity="0.1"/>
                  <polyline points="20 6 9 17 4 12" fill="none" stroke="var(--orange-500)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{perk}</span>
              </div>
            ))}
          </div>

          <div class="wm-vp-footer">
            <a href="#komunitas" class="btn btn-primary wm-main-btn">
              <span>{valueProp.ctaText}</span>
              <ArrowRight size={15} />
            </a>
            <p class="wm-vp-note">{valueProp.note}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 8. SIAP SCALE TANPA ASAL NAIKKAN BUDGET? ============ -->
    <section class="wm-section">
      <div class="container">
        <div class="wm-ch-card reveal">
          <h2 class="wm-ch-heading">{closingHook.heading}</h2>
          <p class="wm-ch-lead">{closingHook.lead}</p>
          <p class="wm-ch-prompt">{closingHook.prompt}</p>

          <ul class="wm-ch-bullets">
            {closingHook.bullets.map((b) => (
              <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" fill="var(--orange-500)" opacity="0.1"/>
                  <polyline points="20 6 9 17 4 12" fill="none" stroke="var(--orange-500)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>

          <div class="wm-ch-warning">
            {closingHook.warningLines.map((w, idx) => (
              <p class={idx === 1 ? "wm-ch-highlight" : ""}>{w}</p>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 9. GRUP RESMI PESERTA (COMMUNITY CARD) ============ -->
    <section id="komunitas" class="wm-section">
      <div class="container">
        <div class="wm-community-box reveal">
          <!-- GRUP RESMI PESERTA -->
          <div class="hero-badge wm-section-badge" style="margin-inline:auto;">
            <Telegram size={16} />
            <span>{community.badge}</span>
          </div>

          <!-- WEBINAR META ADS TENTAKLIK -->
          <h2 class="section-title wm-comm-title">
            {community.title}
          </h2>

          <!-- Setelah mendaftar... -->
          <p class="wm-comm-desc">
            {community.desc}
          </p>

          <!-- YANG AKAN KAMU DAPATKAN: -->
          <div class="wm-comm-perks-box">
            <div class="wm-comm-perks-heading">{community.perksHeading}</div>
            <div class="wm-comm-perks-grid">
              {community.perks.map((p) => (
                <div class="wm-comm-perk-cell">
                  <div class="wm-comm-check-icon">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </div>
                  <div>
                    <h4 class="wm-comm-perk-title">{p.title}</h4>
                    <p class="wm-comm-perk-sub">{p.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- [ GABUNG SEKARANG ] -->
          <div class="wm-comm-action">
            <a
              href={telegramUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-cta-community
              class="btn btn-primary wm-comm-btn"
            >
              <Telegram size={22} />
              <span>{community.ctaText}</span>
            </a>
            <!-- 100% Gratis · Akses Peserta via Komunitas -->
            <p class="wm-comm-footnote">
              <span class="pulse-dot"></span>
              <span>{community.footnote}</span>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Mobile Sticky CTA -->
    <div class="wm-mobile-sticky">
      <a
        href={telegramUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-cta-community
        class="btn btn-primary wm-mobile-sticky-btn"
      >
        <Telegram size={18} />
        <span>GABUNG WEBINAR GRATIS</span>
      </a>
    </div>
  </div>

  <!-- Click Tracking Script -->
  <script is:inline>
    (function() {
      var ctaButtons = document.querySelectorAll('[data-cta-community]');
      ctaButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: 'join_community',
            platform: 'telegram',
            kategori: 'webinar_meta',
            source: window.location.pathname
          });

          if (typeof window.fbq === 'function') {
            window.fbq('track', 'Lead', {
              content_name: 'Webinar Meta Ads',
              content_category: 'Webinar'
            });
          }
        });
      });
    })();
  </script>
</BaseLayout>

<style>
  /* ==========================================================================
     Webinar Meta Ads Page Styles — Strict Alignment to eventfb.md & Homepage
     ========================================================================== */
  
  .wm-page {
    background: var(--bg);
    color: var(--ink-900);
    overflow-x: hidden;
  }

  .bg-warm {
    background: var(--bg-warm);
  }

  .wm-section {
    padding: 72px 0;
  }

  /* Ambient Glows */
  .ambient-glows {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .glow-top-right {
    position: absolute;
    top: -80px;
    right: -120px;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,122,26,0.10), rgba(255,122,26,0) 70%);
  }
  .glow-bottom-left {
    position: absolute;
    bottom: -60px;
    left: -100px;
    width: 360px;
    height: 360px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,122,26,0.06), rgba(255,122,26,0) 70%);
  }

  /* 1. Hero */
  .wm-hero-section {
    padding-top: 48px;
    padding-bottom: 56px;
    position: relative;
    overflow: hidden;
    background: #FFFFFF;
  }
  .wm-hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .hero-badge-wrap {
    display: flex;
    justify-content: flex-start;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    border-radius: 999px;
    background: white;
    border: 1px solid var(--ink-100);
    box-shadow: 0 2px 8px rgba(31,26,23,0.04);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-700);
  }
  .hero-badge-icon {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--orange-500);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .wm-hero-title {
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.25;
    margin-top: 20px;
    margin-bottom: 16px;
    letter-spacing: -0.02em;
    font-weight: 800;
    color: var(--ink-900);
  }
  .wm-hero-title-line {
    display: block;
    white-space: nowrap;
  }
  .wm-hero-subtitle {
    font-size: 18px;
    font-weight: 500;
    color: var(--ink-700);
    line-height: 1.4;
    margin-bottom: 20px;
  }
  .wm-story-framed-container {
    margin-top: 44px;
    position: relative;
    z-index: 1;
  }
  .wm-story-frame {
    background: #FFFDFB;
    border: 2px solid var(--orange-200);
    border-radius: 20px;
    padding: 24px 32px;
    box-shadow: 0 8px 24px rgba(255,122,26,0.06);
    max-width: 840px;
    margin: 0 auto;
    text-align: center;
  }
  .wm-story-frame-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 16px;
    color: var(--ink-700);
    line-height: 1.55;
  }
  .wm-story-line {
    margin: 0;
    font-weight: 400;
  }
  .wm-story-danger {
    color: #DC2626;
    font-weight: 500;
    font-size: 16px;
    margin: 2px 0;
  }
  .wm-story-punch {
    color: var(--ink-900);
    font-weight: 600;
    font-size: 16.5px;
    margin-top: 4px;
  }
  .wm-hero-desc {
    font-size: 15.5px;
    color: var(--ink-500);
    line-height: 1.65;
    max-width: 540px;
    margin-bottom: 28px;
  }
  .wm-cta-group {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .wm-main-btn {
    background: var(--orange-500) !important;
    color: white !important;
    border-radius: 10px !important;
    padding: 15px 32px !important;
    font-size: 15.5px !important;
    font-weight: 800 !important;
    box-shadow: 0 6px 20px rgba(255,122,26,0.32) !important;
    transition: all 0.2s ease !important;
    letter-spacing: 0.02em;
  }
  .wm-main-btn:hover {
    background: var(--orange-600) !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 10px 26px rgba(255,122,26,0.42) !important;
  }
  .wm-proof-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 700;
    color: #059669;
  }
  .wm-mascot-box {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    filter: drop-shadow(0 20px 40px rgba(255,122,26,0.14));
  }
  .wm-mascot-img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Section Headers */
  .section-header-wrap {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 44px auto;
  }
  .wm-section-badge {
    margin-bottom: 14px;
    font-size: 13px;
    font-weight: 600;
  }
  .wm-section-title {
    font-size: 28px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--ink-900);
    letter-spacing: -0.015em;
    margin: 0 0 12px 0;
