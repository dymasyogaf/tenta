---
import BaseLayout from "@layouts/BaseLayout.astro";
import ArrowRight from "@components/icons/ArrowRight.astro";
import Telegram from "@components/icons/Telegram.astro";
import { WEBINAR_META as W } from "@data/webinar-meta";

const { seo, hero, problems, caseStudy, curriculum, audience, speaker, agenda, valueProp, closingHook, community, event } = W;
const telegramUrl = W.telegramUrl || 'https://t.me/webinartentaklik';
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  bareHeader={true}
  bareLayout={true}
  noindex={false}
  gtmId="GTM-T2FDL7NM"
  themeColor="#FFFFFF"
>
  <Fragment slot="head">
    <!-- Meta Pixel Code -->
    <script is:inline>
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod
            ? n.callMethod.apply(n, arguments)
            : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = "2.0";
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(
        window,
        document,
        "script",
        "https://connect.facebook.net/en_US/fbevents.js",
      );
      fbq("set", "autoConfig", false, "1341980327384883");
      fbq("init", "1341980327384883");
      fbq("track", "PageView");
    </script>
    <noscript
      ><img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=1341980327384883&ev=PageView&noscript=1"
      /></noscript
    >

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Event",
      "name": "Webinar Meta Ads Tentaklik — Bedah Kesalahan Scaling",
      "startDate": event?.isoDate || "2026-09-25T20:00:00+07:00",
      "endDate": "2026-09-25T22:00:00+07:00",
      "eventAttendanceMode": "https://schema.org/OnlineEventAttendanceMode",
      "eventStatus": "https://schema.org/EventScheduled",
      "location": { "@type": "VirtualLocation", "name": "Zoom" },
      "performer": { "@type": "Person", "name": speaker.name },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "IDR",
        "availability": "https://schema.org/InStock"
      }
    })} />

    <style is:global>
      html {
        scroll-behavior: smooth;
      }
      .footer {
        margin-top: 0 !important;
      }
    </style>
  </Fragment>

  <div class="wm-page">
    <!-- ============ 1. HERO ============ -->
    <section class="hero-wrap wm-hero-section">
      <!-- Ambient Glows -->
      <div aria-hidden="true" class="ambient-glows">
        <div class="glow-top-right"></div>
        <div class="glow-bottom-left"></div>
      </div>

      <div class="container hero-grid wm-hero-grid">
        <!-- Text Column -->
        <div class="hero-content">
          <!-- LIVE SESSION 100% FREE VIA ZOOM -->
          <div class="hero-badge-wrap">
            <div class="hero-badge">
              <span class="hero-badge-icon">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2L4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6l-8-4z" fill="white"/><path d="M9 12l2 2 4-4" stroke="var(--orange-500)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span>{hero.badge}</span>
            </div>
          </div>

          <!-- Punya iklan yang tadinya untung? Pas di-scale kok malah buntung? -->
          <h1 class="hero-title wm-hero-title">
            <span class="wm-hero-title-line">Punya iklan yang <span style="color:var(--orange-500);">tadinya untung?</span></span>
            <span class="wm-hero-title-line">Pas di-scale kok <span style="color:var(--orange-500);">malah buntung?</span></span>
          </h1>

          <!-- Bedah Kesalahan Scaling yang Bikin Campaign Profitable Kehilangan Performanya -->
          <p class="wm-hero-subtitle">
            {hero.subtitle}
          </p>

          <!-- Event Date & Platform Bar -->
          {event && (
            <div class="wm-hero-event-bar">
              <div class="wm-hevent-card">
                <div class="wm-hevent-row">
                  <div class="wm-hevent-icon-wrap">
                    <svg class="wm-event-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                      <line x1="16" y1="2" x2="16" y2="6"/>
                      <line x1="8" y1="2" x2="8" y2="6"/>
                      <line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                  </div>
                  <div class="wm-hevent-details">
                    <span class="wm-hevent-tag">JADWAL WEBINAR</span>
                    <span class="wm-hevent-text">{event.date} · Pukul {event.time}</span>
                  </div>
                </div>
                <div class="wm-hevent-divider"></div>
                <div class="wm-hevent-row">
                  <div class="wm-hevent-icon-wrap">
                    <svg class="wm-event-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polygon points="23 7 16 12 23 17 23 7"/>
                      <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
                    </svg>
                  </div>
                  <div class="wm-hevent-details">
                    <span class="wm-hevent-tag">LOKASI EVENT</span>
                    <span class="wm-hevent-text">{event.platform} Meeting</span>
                  </div>
                </div>
              </div>
            </div>
          )}

          <!-- [ GABUNG WEBINAR GRATIS ] / 100% Gratis · Live via Zoom -->
          <div class="hero-cta-group wm-cta-group">
            <div class="hero-buttons-wrap">
              <a href="#komunitas" class="btn btn-primary wm-main-btn">
                <span>{hero.ctaText}</span>
                <ArrowRight size={15} />
              </a>
            </div>
            <div class="wm-proof-badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>{hero.ctaSub}</span>
            </div>
          </div>
        </div>

        <!-- Mascot / Hero Visual Column -->
        <div class="hero-mascot-wrap">
          <div class="kraken-float wm-mascot-box">
            <img
              src={hero.mockupSrc}
              alt="Tentaklik Meta Ads Hero"
              width="560"
              height="540"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="wm-mascot-img"
            />
          </div>
        </div>
      </div>

      <!-- Framed Story Card Below Hero Grid -->
      <div class="container wm-story-framed-container">
        <div class="wm-story-frame reveal">
          <div class="wm-story-frame-content">
            {hero.story.map((line, idx) => (
              <p class={idx === 3 ? "wm-story-danger" : idx === 4 ? "wm-story-punch" : "wm-story-line"}>
                {line}
              </p>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 2. KENDALA UTAMA (PERNAH MENGALAMI INI?) ============ -->
    <section class="wm-section bg-warm">
      <div class="container">
        <div class="section-header-wrap">
          <div class="hero-badge wm-section-badge">
            <span>{problems.eyebrow}</span>
          </div>
          <h2 class="section-title wm-section-title">
            {problems.heading}
          </h2>
        </div>

        <div class="wm-problems-grid">
          {problems.items.map((item) => (
            <div class="wm-card wm-problem-card reveal">
              <div class="wm-prob-icon-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
              </div>
              <p class="wm-prob-text">{item}</p>
            </div>
          ))}
        </div>

        <!-- Kalau pernah mengalami ini, webinar ini untuk kamu. -->
        <div class="wm-closer-callout reveal">
          <div class="wm-closer-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <span class="wm-closer-text">{problems.closer}</span>
        </div>
      </div>
    </section>

    <!-- ============ 2.5 BUKTI NYATA (STUDI KASUS BEFORE & AFTER) ============ -->
    {caseStudy && (
      <section id="bukti-nyata" class="wm-section wm-cs-section">
        <div class="container">
          <div class="section-header-wrap">
            <div class="hero-badge wm-section-badge">
              <span>{caseStudy.eyebrow}</span>
            </div>
            <h2 class="section-title wm-section-title">
              {caseStudy.heading}
            </h2>
            <p class="wm-section-sub">
              {caseStudy.sub}
            </p>
          </div>

          <div class="wm-cs-grid">
            <!-- BEFORE CARD -->
            <div class="wm-card wm-cs-card wm-cs-before reveal">
              <div class="wm-cs-card-top">
                <div class="wm-cs-badge wm-badge-before">
                  <span class="wm-cs-dot-before" aria-hidden="true"></span>
                  <span>{caseStudy.before.badge}</span>
                </div>
                <h3 class="wm-cs-title">{caseStudy.before.title}</h3>
              </div>

              <!-- Metrics Summary Bar -->
              <div class="wm-cs-metrics">
                <div class="wm-cs-metric-item">
                  <span class="wm-cs-metric-label">{caseStudy.before.cprLabel}</span>
                  <span class="wm-cs-metric-val wm-metric-danger">{caseStudy.before.cprValue}</span>
                </div>
                <div class="wm-cs-metric-divider"></div>
                <div class="wm-cs-metric-item">
                  <span class="wm-cs-metric-label">{caseStudy.before.cpmLabel}</span>
                  <span class="wm-cs-metric-val">{caseStudy.before.cpmValue}</span>
                </div>
                <div class="wm-cs-metric-divider"></div>
                <div class="wm-cs-metric-item">
                  <span class="wm-cs-metric-label">{caseStudy.before.resultsLabel}</span>
                  <span class="wm-cs-metric-val">{caseStudy.before.resultsValue}</span>
                </div>
              </div>

              <!-- Interactive Dashboard Screenshot -->
              <div class="wm-cs-img-container" data-zoom-src={caseStudy.before.image} data-zoom-caption="Before: Dashboard Meta Ads Sebelum Optimasi">
                <img
                  src={caseStudy.before.image}
                  alt="Dashboard Meta Ads Sebelum Optimasi"
                  loading="lazy"
                  decoding="async"
                  class="wm-cs-screenshot"
                  width="1600"
                  height="900"
                />
                <div class="wm-cs-zoom-pill">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                  <span>Klik untuk perbesar</span>
                </div>
              </div>

              <!-- Caption Box -->
              <div class="wm-cs-caption-box">
                <p class="wm-cs-caption-text">
                  <strong class="wm-caption-tag wm-tag-danger">❌ BEFORE:</strong>
                  {caseStudy.before.caption.replace(/^Biaya ATC/, 'Biaya ATC')}
                </p>
              </div>
            </div>

            <!-- AFTER CARD -->
            <div class="wm-card wm-cs-card wm-cs-after reveal">
              <div class="wm-cs-card-top">
                <div class="wm-cs-badge wm-badge-after">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{caseStudy.after.badge}</span>
                </div>
                <h3 class="wm-cs-title">{caseStudy.after.title}</h3>
              </div>

              <!-- Metrics Summary Bar -->
              <div class="wm-cs-metrics">
                <div class="wm-cs-metric-item">
                  <span class="wm-cs-metric-label">{caseStudy.after.cprLabel}</span>
                  <span class="wm-cs-metric-val wm-metric-success">{caseStudy.after.cprValue}</span>
                </div>
                <div class="wm-cs-metric-divider"></div>
                <div class="wm-cs-metric-item">
                  <span class="wm-cs-metric-label">{caseStudy.after.cpmLabel}</span>
                  <span class="wm-cs-metric-val">{caseStudy.after.cpmValue}</span>
                </div>
                <div class="wm-cs-metric-divider"></div>
                <div class="wm-cs-metric-item">
                  <span class="wm-cs-metric-label">{caseStudy.after.resultsLabel}</span>
                  <span class="wm-cs-metric-val wm-metric-success">{caseStudy.after.resultsValue}</span>
                </div>
              </div>

              <!-- Interactive Dashboard Screenshot -->
              <div class="wm-cs-img-container" data-zoom-src={caseStudy.after.image} data-zoom-caption="After: Dashboard Meta Ads Setelah Optimasi & Scaling">
                <img
                  src={caseStudy.after.image}
                  alt="Dashboard Meta Ads Setelah Optimasi & Scaling"
                  loading="lazy"
                  decoding="async"
                  class="wm-cs-screenshot"
                  width="1600"
                  height="900"
                />
                <div class="wm-cs-zoom-pill">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                  <span>Klik untuk perbesar</span>
                </div>
              </div>

              <!-- Caption Box -->
              <div class="wm-cs-caption-box">
                <p class="wm-cs-caption-text">
                  <strong class="wm-caption-tag wm-tag-success">✅ AFTER:</strong>
                  {caseStudy.after.caption.replace(/^Biaya ATC/, 'Biaya ATC')}
                </p>
              </div>
            </div>
          </div>

          <!-- Bottom Takeaway Callout -->
          {caseStudy.takeaway && (
            <div class="wm-cs-takeaway reveal">
              <div class="wm-cs-takeaway-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
              </div>
              <p class="wm-cs-takeaway-text">
                {caseStudy.takeaway}
              </p>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- ============ 3. MATERI SESI (YANG AKAN KAMU PELAJARI) ============ -->
    <section id="materi" class="wm-section">
      <div class="container">
        <div class="section-header-wrap">
          <div class="hero-badge wm-section-badge">
            <span>{curriculum.eyebrow}</span>
          </div>
          <h2 class="section-title wm-section-title">
            {curriculum.heading}
          </h2>
        </div>

        <div class="wm-curriculum-grid">
          {curriculum.items.map((item) => (
            <div class="wm-card wm-curriculum-card reveal">
              <div>
                <h3 class="wm-curr-title">{item.title}</h3>
                {item.lead && <p class="wm-curr-lead">{item.lead}</p>}
                {item.desc && <p class="wm-curr-desc">{item.desc}</p>}
                
                {/* 04 Bullets */}
                {item.bullets && (
                  <ul class="wm-curr-bullets">
                    {item.bullets.map((b) => (
                      <li>
                        <span class="wm-bullet-dot"></span>
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {/* 05 Questions */}
                {item.sublead && <p class="wm-curr-sublead">{item.sublead}</p>}
                {item.questions && (
                  <ul class="wm-curr-questions">
                    {item.questions.map((q) => (
                      <li>
                        <span class="wm-q-arrow">→</span>
                        <span>{q}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              {/* 03 Framework STOP - WAIT - SCALE */}
              {item.framework && (
                <div class="wm-framework-wrap">
                  {item.framework.map((f) => (
                    <div class={`wm-framework-cell f-${f.label.toLowerCase()}`}>
                      <div class="wm-framework-label">{f.label}</div>
                      <div class="wm-framework-desc">{f.desc}</div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 4. TARGET PESERTA (SIAPA YANG WAJIB HADIR?) ============ -->
    <section class="wm-section bg-warm">
      <div class="container">
        <div class="section-header-wrap">
          <div class="hero-badge wm-section-badge">
            <span>{audience.eyebrow}</span>
          </div>
          <h2 class="section-title wm-section-title">
            {audience.heading}
          </h2>
          <p class="wm-section-sub">
            {audience.sub}
          </p>
        </div>

        <div class="wm-audience-grid">
          {audience.items.map((item, idx) => (
            <div class="wm-card wm-aud-card reveal">
              <div class="wm-aud-top">
                <span class="wm-aud-num">0{idx + 1}</span>
                <span class="wm-aud-check">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
              </div>
              <h3 class="wm-aud-role">{item.role}</h3>
              <p class="wm-aud-desc">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 5 & 6. PEMBICARA & AGENDA ============ -->
    <section id="pembicara" class="wm-section">
      <div class="container">
        <div class="wm-sa-grid">
          <!-- KIRI: PEMBICARA -->
          <div class="wm-sa-speaker reveal">
            <div class="wm-sa-eyebrow">{speaker.eyebrow}</div>

            <img
              src={speaker.photoSrc}
              alt={speaker.name}
              width="260"
              height="260"
              loading="lazy"
              decoding="async"
              class="wm-sa-avatar"
            />

            <h3 class="wm-sa-name">{speaker.name}</h3>
            <p class="wm-sa-role">
              {speaker.titleLine1}<br/>
              {speaker.titleLine2}
            </p>

            <p class="wm-sa-bio">{speaker.bio}</p>
          </div>

          <!-- KANAN: AGENDA -->
          <div class="wm-sa-agenda reveal">
            <div class="wm-sa-eyebrow">{agenda.eyebrow}</div>
            <h2 class="wm-sa-heading">{agenda.heading}</h2>

            <div class="wm-sa-items">
              {agenda.items.map((item) => (
                <div class="wm-sa-item">
                  <span class="wm-sa-num">{item.num}</span>
                  <div class="wm-sa-item-text">
                    <span class="wm-sa-item-title">{item.title}</span>
                    <span class="wm-sa-item-desc">{item.desc}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 7. LIVE SESSION · 100% GRATIS ============ -->
    <section class="wm-section bg-warm">
      <div class="container">
        <div class="wm-vp-card reveal">
          <div class="wm-vp-top">
            <div class="wm-sa-eyebrow">{valueProp.badge}</div>
            <h2 class="wm-vp-heading">{valueProp.heading}</h2>
            <p class="wm-vp-sub">{valueProp.subheading}</p>
            {event && (
              <div class="wm-vp-schedule-badge">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                <span>{event.date} · Pukul {event.time}</span>
              </div>
            )}
          </div>

          <div class="wm-vp-perks">
            {valueProp.perks.map((perk) => (
              <div class="wm-vp-perk">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" fill="var(--orange-500)" opacity="0.1"/>
                  <polyline points="20 6 9 17 4 12" fill="none" stroke="var(--orange-500)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{perk}</span>
              </div>
            ))}
          </div>

          <div class="wm-vp-footer">
            <a href="#komunitas" class="btn btn-primary wm-main-btn">
              <span>{valueProp.ctaText}</span>
              <ArrowRight size={15} />
            </a>
            <p class="wm-vp-note">{valueProp.note}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 8. SIAP SCALE TANPA ASAL NAIKKAN BUDGET? ============ -->
    <section class="wm-section">
      <div class="container">
        <div class="wm-ch-card reveal">
          <h2 class="wm-ch-heading">{closingHook.heading}</h2>
          <p class="wm-ch-lead">{closingHook.lead}</p>
          <p class="wm-ch-prompt">{closingHook.prompt}</p>

          <ul class="wm-ch-bullets">
            {closingHook.bullets.map((b) => (
              <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" fill="var(--orange-500)" opacity="0.1"/>
                  <polyline points="20 6 9 17 4 12" fill="none" stroke="var(--orange-500)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>

          <div class="wm-ch-warning">
            {closingHook.warningLines.map((w, idx) => (
              <p class={idx === 1 ? "wm-ch-highlight" : ""}>{w}</p>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 9. GRUP RESMI PESERTA (COMMUNITY CARD) ============ -->
    <section id="komunitas" class="wm-section">
      <div class="container">
        <div class="wm-community-box reveal">
          <!-- GRUP RESMI PESERTA -->
