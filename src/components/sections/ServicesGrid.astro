---
import { getLang, useT } from '@i18n/utils';
const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const L = (p: string) => (lang === 'en' ? '/en' + (p === '/' ? '' : p) : p) || '/';
import ArrowRight from '../icons/ArrowRight.astro';

const services = [
  {
    title: lang === 'en' ? 'Tier 1 Ad Accounts' : 'Akun Iklan Tier 1',
    desc: t('svcgrid.sewaAkun.desc'),
    slug: 'sewa-akun',
    image: '/assets/services/tier-1-ad-account.avif'
  },
  {
    title: lang === 'en' ? 'Website Development' : 'Website Development',
    desc: t('svcgrid.website.desc'),
    slug: 'website',
    image: '/assets/services/website-development.avif'
  },
  {
    title: lang === 'en' ? 'Digital Marketing Consulting' : 'Konsultasi Digital Marketing',
    desc: t('svcgrid.konsultasi.desc'),
    slug: 'konsultasi',
    image: '/assets/services/konsultasi-digital-marketing.avif'
  },
] as const;
---
<section id="layanan" style="padding-top: 20px; padding-bottom: 40px;">
  <div class="container">
    <div style="text-align:center;margin-bottom:40px;position:relative;">
      <h2 class="section-title">{t('svcgrid.title')}</h2>
      <p class="section-sub">{t('svcgrid.sub')}</p>
      <span class="spark" style="top:-10px;left:15%;font-size:18px;" aria-hidden="true">✦</span>
      <span class="spark" style="top:20px;right:12%;font-size:14px;" aria-hidden="true">✦</span>
    </div>
    <div class="services-grid-list">
      {services.map(s => (
        <a href={L(`/layanan/${s.slug}`)} class="service-card reveal" aria-label={`${s.title} - ${t('svcgrid.cta')}`}>
          <div class="service-image-box">
            <img src={s.image} alt={s.title} loading="lazy" width="240" height="180" />
          </div>
          <h3 class="service-title">{s.title}</h3>
          <p class="service-desc">{s.desc}</p>
          <div class="btn btn-primary service-cta-btn">
            {t('svcgrid.cta')} <ArrowRight size={14} />
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .services-grid-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
  }
  .service-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    gap: 0;
    text-decoration: none;
    color: inherit;
    background: var(--card, #ffffff);
    border-radius: var(--radius-xl, 20px);
    border: 1px solid var(--ink-100, #eee);
    padding: 24px;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    cursor: pointer;
  }
  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(255, 107, 26, 0.14);
    border-color: var(--orange-300);
  }
  .service-image-box {
    width: 100%;
    height: 190px;
    background: #FFFDF9;
    border: 1px solid rgba(255, 122, 26, 0.12);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    overflow: hidden;
    flex-shrink: 0;
    margin-bottom: 16px;
  }
  .service-image-box img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.25s ease;
  }
  .service-card:hover .service-image-box img {
    transform: scale(1.04);
  }
  .service-title {
    font-size: 20px;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 8px;
    color: var(--ink-900);
    min-height: 28px;
    display: flex;
    align-items: center;
  }
  .service-desc {
    font-size: 14px;
    color: var(--ink-500);
    line-height: 1.6;
    margin-bottom: 20px;
    min-height: 68px;
    flex-grow: 1;
  }
  .service-cta-btn {
    padding: 12px 20px;
    font-size: 14.5px;
    justify-content: center;
    margin-top: auto;
    width: 100%;
    box-sizing: border-box;
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .service-card:hover .service-cta-btn {
    background: var(--orange-600);
    transform: translateY(-1px);
    box-shadow: 0 10px 22px rgba(255, 107, 26, 0.34);
  }
  @media (max-width: 992px) {
    .services-grid-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .services-grid-list {
      grid-template-columns: 1fr;
      max-width: 440px;
      margin-inline: auto;
    }
    .service-card {
      text-align: left;
      align-items: stretch;
      padding: 22px;
    }
    .service-title {
      text-align: left;
      justify-content: flex-start;
    }
    .service-desc {
      text-align: left;
      min-height: auto;
      margin-bottom: 18px;
    }
    .service-cta-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
