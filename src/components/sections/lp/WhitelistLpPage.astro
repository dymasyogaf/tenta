---
// Halaman LP whitelist (Meta/Google) — dipakai oleh route ID & EN.
// Tipis: pilih data per (platform, lang), render section yang sama.
import BaseLayout from '@layouts/BaseLayout.astro';
import LpHero from '@components/sections/lp/LpHero.astro';
import LpWhyPlatform from '@components/sections/lp/LpWhyPlatform.astro';
import LpComparison from '@components/sections/lp/LpComparison.astro';
import LpPhotoVisit from '@components/sections/lp/LpPhotoVisit.astro';
import IndustriesGrid from '@components/sections/IndustriesGrid.astro';
import LpTestimonials from '@components/sections/lp/LpTestimonials.astro';
import LpPromoBanner from '@components/sections/lp/LpPromoBanner.astro';
import LpShortForm from '@components/sections/lp/LpShortForm.astro';
import { META_LP, GOOGLE_LP, TIKTOK_LP, INDUSTRIES_LP, INDUSTRY_LP_HEADING } from '@data/whitelist-lp';
import { serviceJsonLd, breadcrumbJsonLd } from '@lib/seo';
import { site } from '@data/site';
import { getLang } from '@i18n/utils';

interface Props { platform: 'meta' | 'google' | 'tiktok' }
const { platform } = Astro.props;
const lang = getLang(Astro.currentLocale);

const content = platform === 'google' 
  ? GOOGLE_LP[lang] 
  : platform === 'tiktok' 
  ? TIKTOK_LP[lang] 
  : META_LP[lang];

const platformLabel = platform === 'meta' ? 'Meta Ads' : platform === 'google' ? 'Google Ads' : 'TikTok Ads';

const seo = {
  title: content.seo.title,
  description: content.seo.description,
  keywords: content.keywords,
  crumbWhitelist: lang === 'en' 
    ? `${platformLabel} Whitelist` 
    : `Akun Whitelist ${platformLabel}`,
};

const slug = platform === 'google' ? 'layanan/akun-google-ads-whitelist' : platform === 'tiktok' ? 'layanan/akun-tiktok-ads-whitelist' : 'layanan/akun-meta-ads-whitelist';
const path = lang === 'en' ? `/en/${slug}` : `/${slug}`;
const url = `${site.url}${path}`;
const crumbSewa = lang === 'en' ? 'Account Rental' : 'Sewa Akun';
const crumbHome = lang === 'en' ? 'Home' : 'Beranda';

const jsonLd = [
  serviceJsonLd({
    name: seo.title,
    description: seo.description,
    url,
    serviceType: `${platformLabel} Whitelist Account Rental`,
  }),
  breadcrumbJsonLd([
    { name: crumbHome, url: lang === 'en' ? `${site.url}/en` : site.url },
    { name: crumbSewa, url: `${site.url}${lang === 'en' ? '/en' : ''}/layanan/sewa-akun-whitelist` },
    { name: seo.crumbWhitelist, url },
  ]),
];
---
<BaseLayout
  title={seo.title}
  description={seo.description}
  active="layanan"
  bareLayout
  jsonLd={jsonLd}
  keywords={seo.keywords}
  preloadHeroSrc="true"
  gtmId={platform === 'google' ? 'GTM-N6FD2GVL' : 'GTM-T2FDL7NM'}
>
    {platform === 'meta' && (
      <Fragment slot="head">
        <!-- Meta Pixel Code -->
        <script is:inline>
          !function(f,b,e,v,n,t,s)
          {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};
          if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
          n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t,s)}(window, document,'script',
          'https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', '1341980327384883');
          fbq('track', 'PageView');
        </script>
        <!-- End Meta Pixel Code -->
        <noscript><img height="1" width="1" style="display:none"
          src="https://www.facebook.com/tr?id=1341980327384883&ev=PageView&noscript=1"
        /></noscript>
      </Fragment>
    )}

  <LpHero
    platform={platform}
    eyebrow={content.hero.eyebrow}
    title={content.hero.title}
    titleAccent={content.hero.titleAccent}
    desc={content.hero.desc}
    ctaText={content.cta.btn}
    ctaHref={`#shortform-${platform}`}
    image={content.hero.image}
  />
  <LpWhyPlatform 
    platform={content.platform} 
    heading={content.whyHeading} 
    sub={content.whySub} 
    items={content.whyItems} 
  />
  <LpComparison platform={content.platform} />
  <IndustriesGrid 
    items={INDUSTRIES_LP[lang]} 
    heading={INDUSTRY_LP_HEADING[lang]} 
    bg="warm" 
    center 
    variant="premium"
  />
  <LpPhotoVisit 
    heading={content.photoHeading} 
    sub={content.photoSub} 
    photos={content.photos} 
    variant="meta" 
  />
  <LpTestimonials items={content.testimonials.map(t => ({ data: t }))} />
  <LpPromoBanner lang={lang} startingPrice={lang === 'en' ? '$31' : 'Rp150.000'} />
  <LpShortForm platform={platform} />
</BaseLayout>
