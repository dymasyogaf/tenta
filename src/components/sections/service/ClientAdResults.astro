---
import type { ClientAdResult } from '@data/sewa-akun';
import { getLang } from '@i18n/utils';

interface Props {
  results: ClientAdResult[];
  title?: string;
  sub?: string;
}

const lang = getLang(Astro.currentLocale);

const {
  results,
  title = lang === 'en' ? 'Real Results From Active Clients' : 'Hasil Nyata Dari Klien Aktif',
  sub = lang === 'en' 
    ? 'Real campaign proofs and high ROAS achieved by brands scaling with our whitelist ad accounts.' 
    : 'Bukti performa scale-up dan ROAS tinggi dari brand yang beriklan menggunakan akun sewa whitelist Tentaklik.',
} = Astro.props;

// Repeat 3 times to guarantee a 100% seamless infinite loop without any visual jump
const marqueeItems = [...results, ...results, ...results];
---

<section class="results-section" aria-labelledby="results-heading">
  <div class="container">
    <div class="results-header">
      <h2 id="results-heading" class="section-title results-title">{title}</h2>
      {sub && <p class="section-sub results-sub">{sub}</p>}
    </div>
  </div>

  <!-- Marquee Container with edge blur & fade -->
  <div class="results-marquee-container">
    <div class="marquee-fade-edge marquee-fade-left" aria-hidden="true"></div>
    <div class="marquee-fade-edge marquee-fade-right" aria-hidden="true"></div>

    <div class="results-marquee-track">
      {marqueeItems.map((item) => (
        <article class="result-card">
          <div class="result-card-img-wrap">
            <img 
              src={item.image} 
              alt={`${item.niche} ad performance dashboard`} 
              class="result-card-img" 
              loading="lazy" 
              decoding="async" 
            />
            <div class="img-overlay-glow"></div>
          </div>
          
          <div class="result-card-body">
            <span class="result-badge">{item.niche}</span>
            
            <div class="result-metrics">
              <div class="metric-item">
                <span class="metric-val metric-val--revenue">{item.revenue}</span>
                <span class="metric-lbl">REVENUE</span>
              </div>
              <div class="metric-item">
                <span class="metric-val metric-val--roas">{item.roas}</span>
                <span class="metric-lbl">ROAS</span>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .results-section {
    padding: 72px 0 64px;
    background: #ffffff;
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  .results-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 40px;
    padding: 0 16px;
  }

  .results-title {
    font-size: 38px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink-900);
    margin-bottom: 12px;
  }

  .results-sub {
    font-size: 16px;
    color: var(--ink-500);
    line-height: 1.6;
    margin: 0 auto;
  }

  /* Marquee wrapper with gradient mask */
  .results-marquee-container {
    position: relative;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    padding: 16px 0 28px;
    -webkit-mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 1) 8%,
      rgba(0, 0, 0, 1) 92%,
      rgba(0, 0, 0, 0) 100%
    );
    mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 1) 8%,
      rgba(0, 0, 0, 1) 92%,
      rgba(0, 0, 0, 0) 100%
    );
  }

  /* Soft edge fade overlays with glass blur */
  .marquee-fade-edge {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 140px;
    z-index: 5;
    pointer-events: none;
  }

  .marquee-fade-left {
    left: 0;
    background: linear-gradient(to right, #ffffff 15%, rgba(255, 255, 255, 0.8) 50%, rgba(255, 255, 255, 0) 100%);
  }

  .marquee-fade-right {
    right: 0;
    background: linear-gradient(to left, #ffffff 15%, rgba(255, 255, 255, 0.8) 50%, rgba(255, 255, 255, 0) 100%);
  }

  /* Marquee Track */
  .results-marquee-track {
    display: flex;
    gap: 24px;
    width: max-content;
    will-change: transform;
    animation: infiniteMarquee 38s linear infinite;
  }

  .results-marquee-track:hover {
    animation-play-state: paused;
  }

  @keyframes infiniteMarquee {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      /* Translate exactly 1/3 since we have 3 identical repeated sets */
      transform: translate3d(-33.333333%, 0, 0);
    }
  }

  /* Fixed-size card to prevent flex stretching */
  .result-card {
    width: 340px;
    max-width: 340px;
    min-width: 340px;
    flex: 0 0 340px;
    box-sizing: border-box;
    background: #ffffff;
    border: 1px solid rgba(226, 232, 240, 0.95);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 30px -10px rgba(10, 37, 64, 0.06);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease;
    display: flex;
    flex-direction: column;
    user-select: none;
  }

  .result-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px -10px rgba(255, 107, 26, 0.16), 0 10px 20px -6px rgba(10, 37, 64, 0.08);
    border-color: rgba(255, 107, 26, 0.45);
  }

  .result-card-img-wrap {
    position: relative;
    width: 100%;
    max-width: 100%;
    height: 195px;
    box-sizing: border-box;
    overflow: hidden;
    background: #f8fafc;
    border-bottom: 1px solid rgba(226, 232, 240, 0.85);
  }

  .result-card-img {
    width: 100%;
    max-width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.4s ease;
  }

  .result-card:hover .result-card-img {
    transform: scale(1.03);
  }

  .img-overlay-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(255,255,255,0) 65%, rgba(255,255,255,0.25) 100%);
  }

  .result-card-body {
    padding: 18px 22px 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
    background: #ffffff;
    box-sizing: border-box;
  }

  .result-badge {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    padding: 4px 11px;
    border-radius: 999px;
    background: rgba(255, 107, 26, 0.09);
    color: var(--orange-600);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 14px;
    border: 1px solid rgba(255, 107, 26, 0.18);
  }

  .result-metrics {
    display: flex;
    align-items: baseline;
    gap: 28px;
    margin-top: auto;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
  }

  .metric-val {
    font-size: 32px;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .metric-val--revenue {
    color: var(--orange-500);
  }

  .metric-val--roas {
    color: var(--ink-900);
  }

  .metric-lbl {
    font-size: 11px;
    font-weight: 800;
    color: var(--ink-400);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .results-marquee-track {
      animation: none;
      overflow-x: auto;
    }
  }

  @media (max-width: 900px) {
    .results-title {
      font-size: 30px;
    }
    .result-card {
      width: 290px;
      max-width: 290px;
      min-width: 290px;
      flex: 0 0 290px;
    }
    .result-card-img-wrap {
      height: 170px;
    }
    .marquee-fade-edge {
      width: 60px;
    }
  }

  @media (max-width: 600px) {
    .results-section {
      padding: 52px 0 44px;
    }
    .results-title {
      font-size: 26px;
    }
    .result-card {
      width: 265px;
      max-width: 265px;
      min-width: 265px;
      flex: 0 0 265px;
    }
    .result-card-img-wrap {
      height: 155px;
    }
    .metric-val {
      font-size: 26px;
    }
    .marquee-fade-edge {
      width: 40px;
    }
  }
</style>
