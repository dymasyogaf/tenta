---
import { getLang, useT } from '@i18n/utils';
import TentaklikLogo from '../brand/TentaklikLogo.astro';
import YouTube from '../icons/YouTube.astro';
import Instagram from '../icons/Instagram.astro';
import TikTok from '../icons/TikTok.astro';
import Telegram from '../icons/Telegram.astro';
import WhatsApp from '../icons/WhatsApp.astro';
import Email from '../icons/Email.astro';
import { site, waLink } from '@data/site';

interface Props {
  lang?: 'en' | 'id';
}
const { lang: propLang } = Astro.props;
const lang = propLang || getLang(Astro.currentLocale);
const t = useT(lang);
const L = (path: string) => {
  if (lang === 'en') {
    if (path === '/') return '/en';
    if (path.startsWith('/#')) return `/en${path.substring(1)}`;
    return `/en${path}`;
  }
  return path || '/';
};
---
<footer class="footer">
  <div class="container footer-grid">
    <div>
      <div style="margin-bottom:14px;"><TentaklikLogo size={24} variant="white" /></div>
      <p style="font-size:14px;color:var(--ink-300);max-width:280px;line-height:1.6;">{t('footer.tagline')}</p>
      <div style="display:flex;gap:12px;margin-top:18px;">
        <a href={site.social.youtube} aria-label="YouTube" target="_blank" rel="noopener noreferrer" style="width:36px;height:36px;border-radius:999px;background:rgba(255,255,255,0.06);display:flex;align-items:center;justify-content:center;"><YouTube size={16} /></a>
        <a href={site.social.instagram} aria-label="Instagram" target="_blank" rel="noopener noreferrer" style="width:36px;height:36px;border-radius:999px;background:rgba(255,255,255,0.06);display:flex;align-items:center;justify-content:center;"><Instagram size={16} /></a>
        <a href={site.social.tiktok} aria-label="TikTok" target="_blank" rel="noopener noreferrer" style="width:36px;height:36px;border-radius:999px;background:rgba(255,255,255,0.06);display:flex;align-items:center;justify-content:center;"><TikTok size={16} /></a>
        <a href={site.social.telegram} aria-label="Telegram" target="_blank" rel="noopener noreferrer" style="width:36px;height:36px;border-radius:999px;background:rgba(255,255,255,0.06);display:flex;align-items:center;justify-content:center;"><Telegram size={16} /></a>
      </div>
    </div>
    <div>
      <h4>{t('footer.layanan')}</h4>
      <ul>
        <li><a href={L("/layanan/jasa-pembuatan-website-after-sales-terbaik")}>{t('svc.website')}</a></li>
        <li>
          <a href={L("/layanan/sewa-akun-whitelist")}>{t('svc.sewaAkun')}</a>
          <ul class="footer-subnav">
            <li><a href={L("/layanan/sewa-akun-whitelist#meta")}>{t('footer.metaWhitelist')}</a></li>
            <li><a href={L("/layanan/sewa-akun-whitelist#google")}>{t('footer.googleWhitelist')}</a></li>
            <li><a href={L("/layanan/sewa-akun-whitelist#tiktok")}>{t('footer.tiktokWhitelist')}</a></li>
          </ul>
        </li>
        <li><a href={L("/layanan/konsultasi-digital-marketing")}>{t('svc.konsultasi')}</a></li>
      </ul>
    </div>
    <div>
      <h4>{t('footer.halaman')}</h4>
      <ul>
        <li><a href={L("/tentang")}>{t('footer.tentang')}</a></li>
        <li><a href={L("/partner")}>{t('footer.partner')}</a></li>
        <li><a href={L("/karir")}>{t('nav.karir')}</a></li>
        <li><a href="https://mediawaktu.com" target="_blank" rel="noopener noreferrer">{t('nav.blog')} ↗</a></li>
      </ul>
    </div>
    <div>
      <h4>{t('footer.kontak')}</h4>
      <ul>
        <li style="display:flex;align-items:center;gap:8px;"><WhatsApp size={14} /> <a href={waLink(lang === 'en' ? 'Hi Tentaklik! I would like to inquire further about your digital marketing services. Can you help?' : 'Halo Tentaklik! Saya ingin menanyakan lebih lanjut mengenai layanan digital marketing Anda. Bisa bantu saya?')} target="_blank" rel="noopener noreferrer" class="footer-wa-link">{site.phone}</a></li>
        <li style="display:flex;align-items:center;gap:8px;"><Email size={14} /> {site.email}</li>
      </ul>
      <div class="footer-partner-logos">
        <div class="footer-partner-logo">
          <picture><source type="image/avif" srcset="/assets/partner-google.avif" /><source type="image/webp" srcset="/assets/partner-google.webp" /><img src="/assets/partner-google.png" alt="Google Partner" width="76" height="26" loading="lazy" decoding="async" /></picture>
        </div>
        <div class="footer-partner-logo">
          <img src="/assets/partner-meta.png" alt="Meta Business Partner" width="76" height="26" loading="lazy" decoding="async" />
        </div>
        <div class="footer-partner-logo">
          <img src="/assets/tiktok-partner.png" alt="TikTok Partner" width="76" height="26" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </div>
  <div class="container footer-legal" style="margin-top:24px;padding-top:20px;border-top:1px solid rgba(255,255,255,0.06);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;font-size:13px;color:var(--ink-300);">
    <span>© {new Date().getFullYear()} PT. Tentakel Bisnis Digital - All Rights Reserved.</span>
    <div style="display:flex;gap:18px;flex-wrap:wrap;">
      <a href={L("/ketentuan")} class="footer-legal-link">{t('footer.terms')}</a>
      <a href={L("/disclaimer")} class="footer-legal-link">{t('footer.disclaimer')}</a>
    </div>
  </div>
</footer>

<style>
  .footer-subnav { list-style: none; padding: 6px 0 0 14px; margin: 6px 0 0; display: flex; flex-direction: column; gap: 8px; border-left: 1px solid rgba(255,255,255,0.12); }
  .footer-subnav li::before { content: "› "; color: var(--ink-300); }
  .footer-legal-link {
    color: var(--ink-300);
    transition: color 0.15s;
  }
  .footer-legal-link:hover {
    color: var(--orange-300);
  }
  .footer-wa-link {
    color: inherit;
    transition: color 0.15s;
  }
  .footer-wa-link:hover,
  .footer-wa-link:focus-visible {
    color: var(--orange-300);
  }

  .footer-partner-logos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-top: 18px;
    width: 100%;
    max-width: 240px;
  }
  .footer-partner-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    border-radius: 8px;
    padding: 4px 6px;
    height: 36px;
    box-sizing: border-box;
  }
  .footer-partner-logo picture {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  .footer-partner-logo img {
    width: 100%;
    height: auto;
    max-height: 22px;
    max-width: 66px;
    object-fit: contain;
    display: block;
  }
</style>
